{
  "name": "office-agents-simulator-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "check:nav": "esbuild scripts/nav-check.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/nav-check.mjs --alias:@=./src --log-level=error && node node_modules/.cache/nav-check.mjs",
    "check:pose": "esbuild scripts/pose-check.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/pose-check.mjs --alias:@=./src --log-level=error && node node_modules/.cache/pose-check.mjs",
    "check:prompt": "esbuild scripts/prompt-sections-check.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/prompt-check.mjs --alias:@=./src --log-level=error && node node_modules/.cache/prompt-check.mjs",
    "check:flow": "esbuild scripts/flow-check.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/flow-check.mjs --alias:@=./src --log-level=error && node node_modules/.cache/flow-check.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@react-three/fiber": "^8.17.10",
    "@react-three/drei": "^9.114.3",
    "three": "^0.170.0",
    "zustand": "^5.0.1",
    "lucide-react": "^0.462.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
