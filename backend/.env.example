# LLM Provider Configuration
# Choose one: openai, anthropic, deepseek, nvidia, minimax, glm, custom_openai, mock
LLM_PROVIDER=mock

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# DeepSeek Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# NVIDIA Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# MiniMax Configuration
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_MODEL=abab6.5-chat

# GLM (ChatGLM) Configuration
GLM_API_KEY=your_glm_api_key_here
GLM_MODEL=glm-4

# Custom OpenAI-compatible Provider
# Use this for any OpenAI-compatible API (Ollama, LM Studio, vLLM, etc.)
CUSTOM_API_KEY=your_custom_api_key_here
CUSTOM_MODEL=your_model_name
CUSTOM_BASE_URL=https://your-api-endpoint.com/v1

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=100
